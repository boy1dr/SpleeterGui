<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Builds with either Visual Studio 2019+ or just the .NET SDK:
        dotnet build -c Release
    The target stays .NET Framework 4.8 on purpose: it ships with every
    Windows 10/11 install, so the exe runs without any runtime download.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <RootNamespace>SpleeterGui</RootNamespace>
    <AssemblyName>SpleeterGui</AssemblyName>
    <ApplicationIcon>spleeter_icon.ico</ApplicationIcon>
    <ApplicationManifest>Properties\app.manifest</ApplicationManifest>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- Lets "dotnet build" compile for .NET Framework without Visual Studio installed. -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Configuration" />
  </ItemGroup>

  <ItemGroup>
    <!-- Images are embedded as plain files (see Assets.cs) so no binary .resx is needed. -->
    <EmbeddedResource Include="Resources\spleeter_logo.png" LogicalName="SpleeterGui.spleeter_logo.png" />
    <EmbeddedResource Include="Resources\form_icon.ico" LogicalName="SpleeterGui.form_icon.ico" />
    <EmbeddedResource Include="Resources\649656_global_32x32.jpg" LogicalName="SpleeterGui.language.jpg" />
    <!-- Fallback copies of the spleeter configs, used when the configs folder next to the exe is missing. -->
    <EmbeddedResource Include="configs\*.json" LogicalName="SpleeterGui.configs.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <!-- The app reads these next to the exe: languages\*.xml and configs\*.json -->
    <Content Include="languages_source\*.xml" Link="languages\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="configs\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Settings.Designer.cs">
      <AutoGen>True</AutoGen>
      <DependentUpon>Settings.settings</DependentUpon>
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
    </Compile>
    <None Update="Properties\Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.cs</LastGenOutput>
    </None>
  </ItemGroup>

</Project>
